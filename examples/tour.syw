  {
   "input": "# Define a function and differentiate it\nf := x -> x^2*sin(x);",
   "outputs": [
    {
     "kind": "math",
     "text": "f := x -> x^2*sin(x)",
     "latex": "f := x \\mapsto x^{2} \\sin{\\left(x \\right)}",
     "pretty": "f := ExprFunction(params=(x,), expr=x**2*sin(x))",
     "label": "f",
     "meta": {
      "prefer_pretty": false
     }
    }
   ]
  },
  {
   "input": "diff(f(x), x);",
   "outputs": [
    {
     "kind": "math",
     "text": "x^2*cos(x) + 2*x*sin(x)",
     "latex": "x^{2} \\cos{\\left(x \\right)} + 2 x \\sin{\\left(x \\right)}",
     "pretty": " 2                    \nx \u22c5cos(x) + 2\u22c5x\u22c5sin(x)",
     "label": "",
     "meta": {
      "prefer_pretty": false
     }
    }
   ]
  },
  {
   "input": "int(exp(-x^2), x = -infinity..infinity);",
   "outputs": [
    {
     "kind": "math",
     "text": "sqrt(Pi)",
     "latex": "\\sqrt{\\pi}",
     "pretty": "\u221a\u03c0",
     "label": "",
     "meta": {
      "prefer_pretty": false
     }
    }
   ]
  },
  {
   "input": "solve({x + y = 3, x - y = 1}, {x, y});",
   "outputs": [
